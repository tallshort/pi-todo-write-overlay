{
  "name": "@tallshort/pi-todo-write-overlay",
  "version": "0.3.5",
  "description": "Persistent top-right todo_write overlay extension for pi.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tallshort/pi-todo-write-overlay.git"
  },
  "bugs": {
    "url": "https://github.com/tallshort/pi-todo-write-overlay/issues"
  },
  "homepage": "https://github.com/tallshort/pi-todo-write-overlay#readme",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "todo",
    "overlay"
  ],
  "files": [
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets/todo-overlay-progress.png",
    "assets/todo-overlay-progress-compact.png"
  ],
  "scripts": {
    "build": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/tallshort/pi-todo-write-overlay/main/assets/todo-overlay-progress.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@sinclair/typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
